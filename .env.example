# Supabase: reads use the anon key; writes (Server Actions, API routes) use the service-role key, which stays on the server.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUMBLE_API_KEY=
ANTHROPIC_API_KEY=

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SIGNING_SECRET=           # required for Mark Sent button.
CRON_SECRET=                    # Vercel Cron: protects the 9am and 4pm reminder run (/api/outreach/reminders).
